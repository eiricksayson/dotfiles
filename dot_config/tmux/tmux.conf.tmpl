#set -g default-terminal "tmux-256color"
set -g default-terminal "xterm-256color"
#set -ga terminal-overrides ",*256col*:Tc"
set -ga terminal-overrides ",xterm-256color:Tc"
# Ghostty reports itself as TERM=xterm-ghostty (not xterm-256color), so the
# override above never matches it and 24-bit hex colors get rounded to the
# nearest ANSI approximation. Add a matching override for Ghostty's actual
# TERM value so truecolor passes through correctly inside tmux.
set -ga terminal-overrides ",xterm-ghostty:Tc"
# Copilot CLI (and other terminal-color-adaptive tools) detect they're inside
# tmux and wrap their color-detection queries (OSC 10/11/4) in tmux's
# passthrough escape sequence (\ePtmux;...\e\\) so the query reaches the real
# terminal instead of tmux answering it. tmux drops that sequence unless
# allow-passthrough is enabled, so without this the query times out and
# falls back to non-adaptive default colors instead of Ghostty's real palette.
set -g allow-passthrough on
# action key
#unbind C-b
#set-option -g prefix C-t
set-option -g repeat-time 0
set-option -g focus-events on
set-option -g base-index 1
set-option -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

#### Key bindings

# Rename current pane
bind-key P command-prompt -p "Rename pane:" "select-pane -T '%%'"

set-window-option -g mode-keys vi

#bind t send-key C-t
# Show personal cheatsheet (Ctrl+t / to open, q or Ctrl+t / to close)
bind / run-shell 'if [ "#{session_name}" = "cheatsheet" ]; then tmux detach-client; else tmux display-popup -w90% -h90% -E "nvim -R -c \"nnoremap q :q!<CR>\" {{ .chezmoi.sourceDir }}/CHEATSHEET.md"; fi'
# Reload settings
bind r source-file ~/.config/tmux/tmux.conf \; display "Reloaded!"
# Open current directory
bind o run-shell "open '#{pane_current_path}'"
bind -r e kill-pane -a

# Sessions-only tree (overrides default choose-tree with windows nested)
bind w choose-tree -s

# Moving window
bind-key -n C-S-Left swap-window -t -1 \; previous-window
bind-key -n C-S-Right swap-window -t +1 \; next-window

#### basic settings

set-option -g status-justify "left"
#set-option utf8-default on
#set-option -g mouse-select-pane
set-window-option -g mode-keys vi
#set-window-option -g utf8 on
# look'n feel
set-option -g status-fg cyan
set-option -g status-bg black
set -g pane-active-border-style fg=colour166,bg=default
# NOTE: previously had `window-style fg=colour10,bg=default` /
# `window-active-style fg=colour12,bg=default` here to dim inactive panes.
# Removed: tmux answers an app's OSC-10 "what's your foreground?" query
# synchronously from this exact style override (never from the real
# terminal), converting the abstract colour index via a hardcoded static
# 256-colour table (colour12 -> literal #0000ff) instead of Ghostty's real
# configured foreground. This broke terminal-color-adaptive rendering (e.g.
# Copilot CLI, vim/nvim background detection, fzf/bat/delta themes) for the
# active pane specifically, making adaptive "info" text render as plain
# blue instead of the real theme color. If pane dimming is wanted again,
# use an attribute-only style (no fg=colourN) so OSC 10/11 queries still
# resolve to the terminal's real default colors.
set-option -g history-limit 64096

set -sg escape-time 10


# allow the title bar to adapt to whatever host you connect to
set -g set-titles on
set -g set-titles-string "#T"

# import
if-shell "uname -s | grep -q Darwin" "source ~/.config/tmux/macos.conf"

source ~/.config/tmux/theme.conf
source ~/.config/tmux/statusline.conf
source ~/.config/tmux/utility.conf

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-pain-control'

run '~/.config/tmux/plugins/tpm/tpm'
